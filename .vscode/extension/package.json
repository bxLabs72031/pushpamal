{
  "name": "pushpamal",
  "version": "0.0.1",
  "publisher": "bxqbit",
  "description": "PushpAmal language support for VS Code",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": ["Programming Languages", "Linters"],
  "contributes": {
    "languages": [
      {
        "id": "pushpamal",
        "aliases": ["PushpAmal", "pushpamal"],
        "extensions": [".pa"],
        "caption": "PushpAmal",
        "icon": "media/pushpamal.svg",
        "comments": "# to end of line",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pushpamal",
        "scopeName": "source.pushpamal",
        "path": "grammars/pushpamal.tmLanguage.json",
        "embeddedLanguages": [
          {
            "language": "text",
            "scope": "string"
          }
        ]
      }
    ],
    "configuration": {
      "title": "PushpAmal",
      "properties": {
        "pushpamal.showStack": {
          "type": "boolean",
          "default": true,
          "description": "Show cycle count in status bar"
        },
        "pushpamal.autoCompile": {
          "type": "boolean",
          "default": false,
          "description": "Auto-compile .pa files on save"
        }
      }
    }
  }
}